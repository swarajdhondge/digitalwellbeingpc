<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>digital_wellbeing_app.App</StartupObject>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <RootNamespace>digital_wellbeing_app</RootNamespace>
    <AssemblyName>DigitalWellbeing</AssemblyName>
    <Product>Pulse - DigitalWellbeingPC</Product>

    <ApplicationIcon>Resources\Icons\digital-balance-icon.ico</ApplicationIcon>
    <Win32Icon>Resources\Icons\digital-balance-icon.ico</Win32Icon>

    <Version>2.3.1</Version>
    
    <!-- Disable assembly info generation to fix WPF temp project duplicate attribute issue -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    
    <!-- Minimum Windows version supported -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <!-- App manifest for DPI awareness and execution level -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Exclude nested test project from compilation -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.20" />
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <!-- SkiaSharp's OpenTK dependency otherwise selects a prerelease native runtime. -->
    <PackageReference Include="OpenTK.redist.glfw" Version="3.3.8.39" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Icons\digital-balance-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Icons\digital-balance-icon-32.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Icons\digital-balance-icon-256.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
