<UserControl
    x:Class="digital_wellbeing_app.Views.AppUsage.AppUsageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:digital_wellbeing_app.ViewModels"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:conv="clr-namespace:digital_wellbeing_app.Converters"
    xmlns:controls="clr-namespace:digital_wellbeing_app.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="900"
    FontFamily="{DynamicResource Font.Primary}"
    Background="Transparent">

    <UserControl.DataContext>
        <vm:AppUsageViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <conv:DurationToWidthConverter x:Key="DurationToWidthConverter"/>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="26,4,26,26">
        <StackPanel x:Name="PageRoot" HorizontalAlignment="Center">

            <!-- Today / Week / History segmented toggle -->
            <Border Style="{StaticResource Pulse.SegmentBar}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Today" AutomationProperties.AutomationId="AppRangeToday"
                                 Style="{StaticResource Pulse.Segment}" GroupName="AppRange" IsChecked="True"
                                 Checked="TodayRange_Checked"/>
                    <RadioButton Content="Week" AutomationProperties.AutomationId="AppRangeWeek"
                                 Style="{StaticResource Pulse.Segment}" GroupName="AppRange"
                                 Checked="WeekRange_Checked"/>
                    <RadioButton Content="History" AutomationProperties.AutomationId="AppRangeHistory"
                                 Style="{StaticResource Pulse.Segment}" GroupName="AppRange"
                                 Checked="HistoryRange_Checked"/>
                </StackPanel>
            </Border>

            <!-- Week navigator (Week mode only) -->
            <controls:WeekNavigator x:Name="WeekNavigator" Margin="0,0,0,16"
                                    Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVisibilityConverter}}"
                                    WeekLabel="{Binding WeekLabel}"
                                    SelectedWeekStart="{Binding SelectedWeekStart}"
                                    EarliestWeekStart="{Binding EarliestWeekStart}"
                                    CanGoPrevious="{Binding CanGoPrevious}"
                                    CanGoNext="{Binding CanGoNext}"/>

            <!-- Day navigator (History mode only) -->
            <Grid Margin="0,0,0,16"
                  Visibility="{Binding IsDayView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PreviousDayButton" Grid.Column="0"
                        Style="{StaticResource Pulse.Button.Icon}" Width="34" Height="34"
                        IsEnabled="{Binding CanGoToPreviousDay}"
                        Click="PreviousDay_Click" ToolTip="Previous day"
                        AutomationProperties.AutomationId="PreviousDay">
                    <md:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
                </Button>
                <!-- Clickable date label + hidden DatePicker for calendar popup -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DailyDateLabel}"
                               Style="{StaticResource Pulse.CardTitle}" FontSize="14"
                               VerticalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonUp="DateLabel_Click"
                               ToolTip="Click to pick a date"/>
                    <md:PackIcon Kind="CalendarMonth" Width="16" Height="16"
                                 Foreground="{DynamicResource Ink3}" VerticalAlignment="Center"
                                 Margin="6,0,0,0" Cursor="Hand"
                                 MouseLeftButtonUp="DateLabel_Click"/>
                    <DatePicker x:Name="HistoryDatePicker" Width="0" Height="0" Opacity="0"
                                SelectedDateChanged="HistoryDatePicker_SelectedDateChanged"
                                DisplayDateEnd="{x:Static sys:DateTime.Today}"/>
                </StackPanel>
                <Button x:Name="NextDayButton" Grid.Column="2"
                        Style="{StaticResource Pulse.Button.Icon}" Width="34" Height="34"
                        IsEnabled="{Binding CanGoToNextDay}"
                        Click="NextDay_Click" ToolTip="Next day"
                        AutomationProperties.AutomationId="NextDay">
                    <md:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
                </Button>
            </Grid>

            <!-- Daily screen-time card (History mode only) -->
            <Border Style="{StaticResource Pulse.Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsDayView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL SCREEN TIME" Style="{StaticResource Pulse.Eyebrow}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding DailyScreenTime}" Style="{StaticResource Pulse.Stat}" FontSize="33"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="13"
                            Background="{DynamicResource Accent.Soft}" VerticalAlignment="Center">
                        <md:PackIcon Kind="CalendarTodayOutline" Width="24" Height="24"
                                     Foreground="{DynamicResource Accent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Now using card removed as requested -->

            <!-- 3 stat tiles (separate cards) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Pulse.Card}" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SwitchCount}" Style="{StaticResource Pulse.Stat}" FontSize="28"/>
                        <TextBlock Text="App switches" Style="{StaticResource Pulse.Body2}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Pulse.Card}" Padding="20" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding AverageFocusTime}" Style="{StaticResource Pulse.Stat}" FontSize="28"/>
                        <TextBlock Text="Avg focus" Style="{StaticResource Pulse.Body2}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Pulse.Card}" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding LongestSessionTime}" Style="{StaticResource Pulse.Stat}" FontSize="28"/>
                        <TextBlock Text="Longest focus" Style="{StaticResource Pulse.Body2}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Today's apps -->
            <Border Style="{StaticResource Pulse.Card}"
                    Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RangeHeader}" Style="{StaticResource Pulse.Eyebrow}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Total " Style="{StaticResource Pulse.Body2}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WeekTotalText}" Style="{StaticResource Pulse.CardTitle}" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TodaysUsage}" AlternationCount="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- P1-1: Click to navigate to App Details for this app -->
                                <Border Style="{StaticResource CardListItem}" Cursor="Hand"
                                        MouseLeftButtonUp="AppRow_Click"
                                        ToolTip="View details for this app">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11"
                                                Background="{DynamicResource Card2}" Margin="0,0,14,0">
                                            <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding AppName}" Style="{StaticResource Pulse.Body}" Margin="0,0,0,7"/>
                                            <Border Height="5" CornerRadius="3" Background="{DynamicResource Track}">
                                                <Border Height="5" CornerRadius="3" HorizontalAlignment="Left"
                                                        Background="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource ColorIndexToTint}}"
                                                        Width="{Binding TotalDuration, Converter={StaticResource DurationToWidthConverter}}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationFormatted}" FontSize="13.5"
                                                   Foreground="{DynamicResource Ink}" VerticalAlignment="Center" MinWidth="56" TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource Pulse.Card}" Padding="40"
                    Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center">
                    <md:PackIcon Kind="CalendarBlankOutline" Width="44" Height="44" Foreground="{DynamicResource Ink3}"
                                 HorizontalAlignment="Center" Margin="0,0,0,14"
                                 Visibility="{Binding IsDayView, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <md:PackIcon Kind="ApplicationOutline" Width="44" Height="44" Foreground="{DynamicResource Ink3}"
                                 HorizontalAlignment="Center" Margin="0,0,0,14"
                                 Visibility="{Binding IsDayView, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Pulse.CardTitle}">
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="Text" Value="No apps tracked yet"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDayView}" Value="True">
                                        <Setter Property="Text" Value="No usage recorded for this day"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Pulse.Body2}">
                                <Setter Property="Text" Value="Start using some applications and they'll appear here."/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDayView}" Value="True">
                                        <Setter Property="Text" Value="No app sessions were tracked on this date."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="Go to Dashboard"
                            Style="{StaticResource Pulse.Button.Ghost}"
                            Margin="0,20,0,0" Padding="20,10"
                            Click="EmptyStateDashboard_Click"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsDayView, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
