<UserControl x:Class="digital_wellbeing_app.Controls.WeekNavigator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{DynamicResource Font.Primary}"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{StaticResource Pulse.Button.Icon}" Width="34" Height="34"
                IsEnabled="{Binding CanGoPrevious, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Click="Previous_Click" ToolTip="Previous week" AutomationProperties.AutomationId="PreviousWeek">
            <md:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
        </Button>

        <Button x:Name="JumpButton" Grid.Column="1" HorizontalAlignment="Center"
                Style="{StaticResource Pulse.Button.Ghost}" Padding="12,6" Click="JumpButton_Click"
                ToolTip="Choose another week" AutomationProperties.AutomationId="ChooseWeek">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding WeekLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource Pulse.CardTitle}" FontSize="14" VerticalAlignment="Center"/>
                <md:PackIcon Kind="CalendarMonthOutline" Width="17" Height="17" Margin="8,0,0,0"
                             Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Button Grid.Column="2" Style="{StaticResource Pulse.Button.Icon}" Width="34" Height="34"
                IsEnabled="{Binding CanGoNext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Click="Next_Click" ToolTip="Next week" AutomationProperties.AutomationId="NextWeek">
            <md:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
        </Button>

        <Popup x:Name="WeekPopup" PlacementTarget="{Binding ElementName=JumpButton}" Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Closed="WeekPopup_Closed">
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,8,0,0"
                    Effect="{DynamicResource Shadow.Card}">
                <StackPanel>
                    <TextBlock Text="JUMP TO A WEEK" Style="{StaticResource Pulse.Eyebrow}" Margin="4,0,0,10"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="This week" Style="{StaticResource Pulse.Button.Ghost}" Padding="10,5"
                                Click="ThisWeek_Click" Margin="0,0,6,0"/>
                        <Button Content="4 weeks back" Style="{StaticResource Pulse.Button.Ghost}" Padding="10,5"
                                Click="FourWeeksBack_Click" Margin="0,0,6,0"/>
                        <Button x:Name="OldestButton" Content="Oldest" Style="{StaticResource Pulse.Button.Ghost}"
                                Padding="10,5" Click="Oldest_Click"/>
                    </WrapPanel>
                    <Calendar x:Name="WeekCalendar" SelectionMode="SingleDate"
                              SelectedDatesChanged="WeekCalendar_SelectedDatesChanged"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
