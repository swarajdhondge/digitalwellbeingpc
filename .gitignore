# >>> .gitignore for Digital Balance solution <<<
# See https://github.com/github/gitignore/blob/main/VisualStudio.gitignore for reference

# Build outputs
**/bin/
**/obj/

# Publish folders
/publish/
/releases/

# MSIX packaging outputs
/installer/bin/
/installer/obj/
/installer/AppPackages/

# Certificates and signing keys
*.pfx
*.p12
*.cer
*.crt
*.key
*.pem
*.snk
Add-AppDevPackage.ps1

# Local secrets and environment overrides
.env
.env.*
!.env.example
secrets.json

# Visual Studio workspace & user files
*.suo
*.user
*.userosscache
*.sln.docstates

# Rider
.idea/

# VS Code
.vscode/

# Visual Studio itself
.vs/

# NuGet
*.nupkg
*.snupkg
*.nuspec
.nuget/
packages/

# Dotnet CLI
project.lock.json
project.fragment.lock.json
artifacts/

# Store/package outputs (regenerated for each release)
*.msix
*.msixupload
*.msixbundle
*.appx
*.appxupload
*.appxbundle

# Local app data and backups
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
pulse-backup-*.zip

# Test results / coverage
TestResults/
*.trx
*.coverage
*.coveragexml

# FlaUI UI-test screenshots
.uishots/

# Logs
*.log

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
*.DS_Store

# Swap files, temp
*.swp
*.tmp
*.bak

# Internal planning / release / store-listing docs — kept LOCAL only, never committed.
docs/

# AI tooling
.claude/
.codex/
.cursor/
.playwright-mcp/
